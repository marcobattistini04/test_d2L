FROM nvidia/cuda:12.8.0-devel-ubuntu24.04
LABEL maintainer="disi-Unibo-NLP"

# Zero interaction e workdir
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace


RUN apt-get update && apt-get install -y \
    curl git wget unzip build-essential python3.12 python3.12-venv python3-pip \
    jq \
    && rm -rf /var/lib/apt/lists/*


RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1


RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH=/root/.local/bin:$PATH

RUN uv venv /root/.venv --python 3.12
ENV VIRTUAL_ENV=/root/.venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

COPY pyproject.5090.toml /workspace/pyproject.toml

RUN uv pip install torch==2.7.0 torchvision==0.22.0 torchaudio==2.7.0 --index-url https://download.pytorch.org/whl/cu128


RUN uv pip install tokenizers==0.21.0
RUN uv pip install https://github.com/mjun0812/flash-attention-prebuild-wheels/releases/download/v0.7.16/flash_attn-2.8.3+cu128torch2.7-cp312-cp312-linux_x86_64.whl
RUN uv pip install https://download.pytorch.org/whl/cu128/flashinfer/flashinfer_python-0.2.6.post1%2Bcu128torch2.7-cp39-abi3-linux_x86_64.whl
RUN uv pip install "xopen>=1.8,<2" tqdm

COPY src /workspace/src

RUN uv pip install --no-build-isolation -e .

ENV PYTHONPATH="/workspace/src:$PYTHONPATH"

ENV DS_BUILD_OPS=0

VOLUME ["/workspace/data", "/workspace/trained_d2l"]

ENV DEBIAN_FRONTEND=dialog